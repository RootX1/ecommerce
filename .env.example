# Copy to .env for local dev. In Cloudflare Pages, set these as
# encrypted environment variables/secrets in the project dashboard —
# never commit real values.

# Headless WordPress/WooCommerce backend (hosted on Xneelo)
PUBLIC_WORDPRESS_API_URL=https://api.yourdomain.co.za/wp-json/wp/v2
PUBLIC_WOOCOMMERCE_API_URL=https://api.yourdomain.co.za/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cloudflare R2 (video storage/CDN)
PUBLIC_R2_VIDEO_BASE_URL=https://videos.yourdomain.co.za

# PayFast (South Africa)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=xxxxxxxxxxxxx
PAYFAST_PASSPHRASE=xxxxxxxxxxxxx
PAYFAST_MODE=sandbox

# Google reCAPTCHA v3
PUBLIC_RECAPTCHA_SITE_KEY=xxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=xxxxxxxxxxxxx
