# Copy to .env for local dev. In Cloudflare Pages, set these as
# encrypted environment variables/secrets in the project dashboard —
# never commit real values.

# WordPress/WooCommerce lives on the PRIMARY domain (no subdomain — see
# docs/DEPLOYMENT.md for why). The storefront is served at /store on that
# same domain via a Cloudflare Worker Route, so this is same-origin from
# the browser's point of view: no CORS config needed.
PUBLIC_WORDPRESS_API_URL=https://yourdomain.co.za/wp-json/wp/v2
PUBLIC_WOOCOMMERCE_API_URL=https://yourdomain.co.za/wp-json/wc/v3
WOOCOMMERCE_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WOOCOMMERCE_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used to build PayFast return/cancel/notify URLs — must include the /store
# base path (see astro.config.mjs `base`).
PUBLIC_SITE_URL=https://yourdomain.co.za/store

# Cloudflare R2 (video storage/CDN) — its own dedicated hostname, unrelated
# to the primary domain/Xneelo, so it does NOT trigger any addon-domain fee.
PUBLIC_R2_VIDEO_BASE_URL=https://videos.yourdomain.co.za

# PayFast (South Africa)
PAYFAST_MERCHANT_ID=10000100
PAYFAST_MERCHANT_KEY=xxxxxxxxxxxxx
PAYFAST_PASSPHRASE=xxxxxxxxxxxxx
PAYFAST_MODE=sandbox

# Google reCAPTCHA v3
PUBLIC_RECAPTCHA_SITE_KEY=xxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=xxxxxxxxxxxxx
