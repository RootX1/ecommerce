---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Order confirmed">
  <div class="confirmation-page">
    <div class="check-icon">✓</div>
    <h1>Order confirmed</h1>
    <p>Thank you for your order! We've emailed your confirmation and will notify you as it ships.</p>
    <a class="continue-btn" href="/">Continue shopping</a>
  </div>
</Layout>

<style>
  .confirmation-page {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
  }
  .check-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #12b76a;
    color: #fff;
    font-size: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  h1 {
    font-size: 20px;
    margin: 0 0 8px;
  }
  p {
    color: var(--muted);
    font-size: 14px;
    max-width: 320px;
  }
  .continue-btn {
    margin-top: 20px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
  }
</style>

<script>
  localStorage.removeItem('tiktok-shop-cart');
</script>
