---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/base';
---

<Layout title="Order confirmed">
  <div class="confirmation-page">
    <p class="order-received">Thank you. Your order has been received.</p>

    <ul class="order-overview" data-order-overview hidden>
      <li>
        <span class="label">Order number:</span>
        <span data-overview-id></span>
      </li>
      <li>
        <span class="label">Email:</span>
        <span data-overview-email></span>
      </li>
      <li>
        <span class="label">Total:</span>
        <span data-overview-total></span>
      </li>
      <li>
        <span class="label">Payment method:</span>
        <span data-overview-payment></span>
      </li>
    </ul>

    <h2>Order details</h2>
    <table class="order-table" data-order-table>
      <thead>
        <tr>
          <th>Product</th>
          <th>Total</th>
        </tr>
      </thead>
      <tbody data-order-items></tbody>
      <tfoot>
        <tr>
          <th scope="row">Subtotal:</th>
          <td data-order-subtotal></td>
        </tr>
        <tr>
          <th scope="row" data-shipping-label>Delivery:</th>
          <td data-order-shipping></td>
        </tr>
        <tr class="order-total-row">
          <th scope="row">Total:</th>
          <td data-order-total></td>
        </tr>
      </tfoot>
    </table>

    <div class="bank-details" data-bank-details hidden>
      <h2>Payment</h2>
      <p class="instructions" data-instructions></p>
      <table class="order-table">
        <tbody data-account-fields></tbody>
      </table>
      <p class="reference-note">Please use your order number as the payment reference so we can match your transfer.</p>
    </div>

    <a class="continue-btn" href={withBase('/')}>Continue shopping</a>
  </div>
</Layout>

<style>
  .confirmation-page {
    min-height: 100%;
    max-width: 480px;
    margin: 0 auto;
    padding: 24px 16px calc(24px + var(--nav-height));
    overflow-y: auto;
  }
  .order-received {
    background: #f0f9f4;
    border: 1px solid #b6e5c8;
    color: #1a7a45;
    padding: 12px 16px;
    border-radius: 6px;
    font-size: 14px;
    margin: 0 0 20px;
  }
  h2 {
    font-size: 16px;
    margin: 24px 0 10px;
    font-weight: 700;
  }
  .order-overview {
    list-style: none;
    margin: 0;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: 6px;
    overflow: hidden;
  }
  .order-overview li {
    display: flex;
    justify-content: space-between;
    padding: 10px 14px;
    font-size: 13px;
    border-bottom: 1px solid var(--border);
  }
  .order-overview li:last-child {
    border-bottom: none;
  }
  .order-overview .label {
    color: var(--muted);
  }
  .order-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .order-table th,
  .order-table td {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
  }
  .order-table thead th {
    background: var(--card-bg);
    font-weight: 700;
  }
  .order-table tfoot th {
    font-weight: 600;
    color: var(--muted);
  }
  .order-table td {
    text-align: right;
  }
  .order-total-row th,
  .order-total-row td {
    font-weight: 700;
    color: var(--fg);
  }
  .bank-details .instructions {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .reference-note {
    font-size: 12px;
    margin: 10px 0 0;
    color: var(--muted);
  }
  .continue-btn {
    display: inline-block;
    margin-top: 24px;
    background: var(--primary);
    color: var(--primary-text);
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
  }
</style>

<script>
  import type { CheckoutResult } from '../../lib/api';

  const ORDER_STORAGE_KEY = 'tiktok-shop-last-order';

  const overviewEl = document.querySelector<HTMLElement>('[data-order-overview]')!;
  const overviewId = document.querySelector<HTMLElement>('[data-overview-id]')!;
  const overviewEmail = document.querySelector<HTMLElement>('[data-overview-email]')!;
  const overviewTotal = document.querySelector<HTMLElement>('[data-overview-total]')!;
  const overviewPayment = document.querySelector<HTMLElement>('[data-overview-payment]')!;
  const itemsBody = document.querySelector<HTMLElement>('[data-order-items]')!;
  const subtotalEl = document.querySelector<HTMLElement>('[data-order-subtotal]')!;
  const shippingLabelEl = document.querySelector<HTMLElement>('[data-shipping-label]')!;
  const shippingEl = document.querySelector<HTMLElement>('[data-order-shipping]')!;
  const totalEl = document.querySelector<HTMLElement>('[data-order-total]')!;
  const bankDetailsEl = document.querySelector<HTMLElement>('[data-bank-details]')!;
  const instructionsEl = document.querySelector<HTMLElement>('[data-instructions]')!;
  const fieldsEl = document.querySelector<HTMLElement>('[data-account-fields]')!;

  const FIELD_LABELS: Record<string, string> = {
    account_name: 'Account name',
    account_number: 'Account number',
    bank_name: 'Bank',
    sort_code: 'Branch code',
    iban: 'IBAN',
    bic: 'SWIFT/BIC',
  };

  function formatZar(amount: number): string {
    return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(amount);
  }

  const raw = sessionStorage.getItem(ORDER_STORAGE_KEY);
  if (raw) {
    try {
      const order: CheckoutResult = JSON.parse(raw);

      overviewEl.hidden = false;
      overviewId.textContent = String(order.orderId);
      overviewEmail.textContent = order.billingEmail;
      overviewTotal.textContent = formatZar(order.total);
      overviewPayment.textContent = order.paymentMethodTitle;

      itemsBody.innerHTML = order.items
        .map(
          (item) => `
        <tr>
          <td>${item.name} × ${item.quantity}</td>
          <td>${formatZar(item.unitPrice * item.quantity)}</td>
        </tr>
      `
        )
        .join('');

      subtotalEl.textContent = formatZar(order.itemsTotal);
      shippingLabelEl.textContent = `${order.shippingTitle || 'Delivery'}:`;
      shippingEl.textContent = order.shippingCost > 0 ? formatZar(order.shippingCost) : 'Free';
      totalEl.textContent = formatZar(order.total);

      if (order.accountDetails?.length) {
        bankDetailsEl.hidden = false;
        instructionsEl.textContent = order.instructions || 'Please transfer the total amount to the account below.';
        for (const account of order.accountDetails) {
          for (const [key, value] of Object.entries(account)) {
            if (!value) continue;
            const row = document.createElement('tr');
            const th = document.createElement('th');
            th.scope = 'row';
            th.textContent = FIELD_LABELS[key] ?? key;
            const td = document.createElement('td');
            td.textContent = String(value);
            td.style.textAlign = 'left';
            row.append(th, td);
            fieldsEl.appendChild(row);
          }
        }
      }
    } catch {
      // malformed/missing order data — the generic thank-you message still shows
    } finally {
      sessionStorage.removeItem(ORDER_STORAGE_KEY);
    }
  }
</script>
