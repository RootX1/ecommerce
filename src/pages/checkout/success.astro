---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/base';
---

<Layout title="Order confirmed">
  <div class="confirmation-page">
    <div class="check-icon">✓</div>
    <h1>Order received</h1>
    <p data-order-ref>Thank you! We've emailed your order confirmation.</p>

    <div class="order-breakdown" data-order-breakdown hidden>
      <div class="breakdown-row"><span>Items</span><span data-breakdown-items></span></div>
      <div class="breakdown-row"><span data-breakdown-shipping-label>Delivery</span><span data-breakdown-shipping></span></div>
      <div class="breakdown-row total"><span>Total</span><span data-breakdown-total></span></div>
    </div>

    <div class="bank-details" data-bank-details hidden>
      <h2>Bank transfer details</h2>
      <p class="instructions" data-instructions></p>
      <dl data-account-fields></dl>
      <p class="reference-note">Please use your order number as the payment reference so we can match your transfer.</p>
    </div>

    <a class="continue-btn" href={withBase('/')}>Continue shopping</a>
  </div>
</Layout>

<style>
  .confirmation-page {
    min-height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px calc(16px + var(--nav-height)) 24px 24px;
    overflow-y: auto;
  }
  .check-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #12b76a;
    color: #fff;
    font-size: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
    flex-shrink: 0;
  }
  h1 {
    font-size: 20px;
    margin: 0 0 8px;
  }
  p {
    color: var(--muted);
    font-size: 14px;
    max-width: 340px;
  }
  .order-breakdown {
    background: #111;
    border-radius: 12px;
    padding: 12px 16px;
    margin-top: 16px;
    width: 100%;
    max-width: 340px;
    text-align: left;
    font-size: 13px;
  }
  .breakdown-row {
    display: flex;
    justify-content: space-between;
    padding: 3px 0;
    color: var(--muted);
  }
  .breakdown-row.total {
    color: #fff;
    font-weight: 700;
    font-size: 15px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 6px;
    padding-top: 8px;
  }
  .bank-details {
    background: #111;
    border-radius: 12px;
    padding: 16px;
    margin-top: 16px;
    width: 100%;
    max-width: 340px;
    text-align: left;
  }
  .bank-details h2 {
    font-size: 15px;
    margin: 0 0 8px;
    color: #fff;
  }
  .instructions {
    font-size: 13px;
    color: var(--muted);
    margin: 0 0 12px;
  }
  .bank-details dl {
    margin: 0;
    font-size: 13px;
  }
  .bank-details dt {
    color: var(--muted);
    margin-top: 8px;
  }
  .bank-details dd {
    margin: 0;
    color: #fff;
    font-weight: 600;
  }
  .reference-note {
    font-size: 12px;
    margin: 12px 0 0;
    color: var(--muted);
  }
  .continue-btn {
    margin-top: 20px;
    background: var(--primary);
    color: var(--primary-text);
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
    flex-shrink: 0;
  }
</style>

<script>
  import type { CheckoutResult } from '../../lib/api';

  const ORDER_STORAGE_KEY = 'tiktok-shop-last-order';

  const orderRefEl = document.querySelector<HTMLElement>('[data-order-ref]')!;
  const breakdownEl = document.querySelector<HTMLElement>('[data-order-breakdown]')!;
  const breakdownItemsEl = document.querySelector<HTMLElement>('[data-breakdown-items]')!;
  const breakdownShippingLabelEl = document.querySelector<HTMLElement>('[data-breakdown-shipping-label]')!;
  const breakdownShippingEl = document.querySelector<HTMLElement>('[data-breakdown-shipping]')!;
  const breakdownTotalEl = document.querySelector<HTMLElement>('[data-breakdown-total]')!;
  const bankDetailsEl = document.querySelector<HTMLElement>('[data-bank-details]')!;
  const instructionsEl = document.querySelector<HTMLElement>('[data-instructions]')!;
  const fieldsEl = document.querySelector<HTMLElement>('[data-account-fields]')!;

  const FIELD_LABELS: Record<string, string> = {
    account_name: 'Account name',
    account_number: 'Account number',
    bank_name: 'Bank',
    sort_code: 'Branch code',
    iban: 'IBAN',
    bic: 'SWIFT/BIC',
  };

  function formatZar(amount: number): string {
    return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(amount);
  }

  const raw = sessionStorage.getItem(ORDER_STORAGE_KEY);
  if (raw) {
    try {
      const order: CheckoutResult = JSON.parse(raw);
      orderRefEl.textContent = `Order #${order.orderId} received — we've emailed your confirmation.`;

      breakdownEl.hidden = false;
      breakdownItemsEl.textContent = formatZar(order.itemsTotal);
      breakdownShippingLabelEl.textContent = order.shippingTitle || 'Delivery';
      breakdownShippingEl.textContent = order.shippingCost > 0 ? formatZar(order.shippingCost) : 'Free';
      breakdownTotalEl.textContent = formatZar(order.total);

      if (order.accountDetails?.length) {
        bankDetailsEl.hidden = false;
        instructionsEl.textContent = order.instructions || 'Please transfer the total amount to the account below.';
        for (const account of order.accountDetails) {
          for (const [key, value] of Object.entries(account)) {
            if (!value) continue;
            const dt = document.createElement('dt');
            dt.textContent = FIELD_LABELS[key] ?? key;
            const dd = document.createElement('dd');
            dd.textContent = String(value);
            fieldsEl.append(dt, dd);
          }
        }
      }
    } catch {
      // malformed/missing order data — the generic thank-you message still shows
    } finally {
      sessionStorage.removeItem(ORDER_STORAGE_KEY);
    }
  }
</script>
