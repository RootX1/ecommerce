---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/base';
---

<Layout title="Payment cancelled">
  <div class="confirmation-page">
    <div class="cancel-icon">✕</div>
    <h1>Payment cancelled</h1>
    <p>Your payment was not completed. Your cart has been saved if you'd like to try again.</p>
    <a class="continue-btn" href={withBase('/cart')}>Back to cart</a>
  </div>
</Layout>

<style>
  .confirmation-page {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 24px;
  }
  .cancel-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: #e11d48;
    color: #fff;
    font-size: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 16px;
  }
  h1 {
    font-size: 20px;
    margin: 0 0 8px;
  }
  p {
    color: var(--muted);
    font-size: 14px;
    max-width: 320px;
  }
  .continue-btn {
    margin-top: 20px;
    background: var(--accent);
    color: #fff;
    text-decoration: none;
    padding: 12px 24px;
    border-radius: 8px;
    font-weight: 600;
  }
</style>
