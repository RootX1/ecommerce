---
import Layout from '../layouts/Layout.astro';
import { withBase } from '../lib/base';
---

<Layout title="Your cart">
  <div class="cart-page">
    <h1>Your Cart</h1>
    <div data-cart-items></div>
    <p class="empty-hint" data-cart-empty hidden>Your cart is empty.</p>
    <div class="cart-total-row" data-cart-total-row hidden>
      <span>Total</span>
      <strong data-cart-total></strong>
    </div>
    <a class="checkout-btn" href={withBase('/checkout')} data-checkout-btn>Checkout</a>
  </div>
</Layout>

<style>
  .cart-page {
    padding: 16px 16px calc(16px + var(--nav-height));
    overflow-y: auto;
    height: 100%;
  }
  h1 {
    font-size: 20px;
  }
  .cart-item {
    display: flex;
    gap: 10px;
    padding: 10px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    align-items: center;
  }
  .cart-item img {
    width: 60px;
    height: 60px;
    border-radius: 8px;
    object-fit: cover;
  }
  .cart-item-info {
    flex: 1;
  }
  .cart-item-name {
    font-size: 14px;
    margin: 0 0 4px;
  }
  .cart-item-price {
    font-size: 13px;
    color: var(--muted);
    margin: 0;
  }
  .cart-item-design {
    font-size: 12px;
    color: var(--secondary);
    margin: 2px 0 0;
  }
  .qty-controls {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .qty-controls button {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: none;
    color: #fff;
    cursor: pointer;
  }
  .remove-btn {
    background: none;
    border: none;
    color: #ff6b6b;
    font-size: 12px;
    cursor: pointer;
    margin-left: 8px;
  }
  .empty-hint {
    color: var(--muted);
    font-size: 14px;
  }
  .cart-total-row {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    margin: 16px 0;
  }
  .checkout-btn {
    display: block;
    text-align: center;
    background: var(--primary);
    color: var(--primary-text);
    text-decoration: none;
    padding: 14px;
    border-radius: 8px;
    font-weight: 600;
  }
</style>

<script>
  import { getCart, updateQuantity, removeFromCart, cartTotal } from '../lib/cart';

  const itemsEl = document.querySelector<HTMLElement>('[data-cart-items]')!;
  const emptyEl = document.querySelector<HTMLElement>('[data-cart-empty]')!;
  const totalRow = document.querySelector<HTMLElement>('[data-cart-total-row]')!;
  const totalEl = document.querySelector<HTMLElement>('[data-cart-total]')!;
  const checkoutBtn = document.querySelector<HTMLAnchorElement>('[data-checkout-btn]')!;

  function formatZar(amount: number): string {
    return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(amount);
  }

  function render() {
    const items = getCart();
    itemsEl.innerHTML = '';

    if (items.length === 0) {
      emptyEl.hidden = false;
      totalRow.hidden = true;
      checkoutBtn.style.pointerEvents = 'none';
      checkoutBtn.style.opacity = '0.5';
      return;
    }

    emptyEl.hidden = true;
    totalRow.hidden = false;
    checkoutBtn.style.pointerEvents = 'auto';
    checkoutBtn.style.opacity = '1';

    for (const item of items) {
      const row = document.createElement('div');
      row.className = 'cart-item';
      row.innerHTML = `
        <img src="${item.imageUrl}" alt="" />
        <div class="cart-item-info">
          <p class="cart-item-name">${item.name}</p>
          <p class="cart-item-price">${formatZar(item.unitPrice)} × ${item.quantity}</p>
          ${item.designImageUrl ? '<p class="cart-item-design">✓ Design uploaded</p>' : ''}
        </div>
        <div class="qty-controls">
          <button data-decrease>-</button>
          <span>${item.quantity}</span>
          <button data-increase>+</button>
        </div>
        <button class="remove-btn" data-remove>Remove</button>
      `;
      row.querySelector('[data-decrease]')?.addEventListener('click', () => {
        updateQuantity(item.productId, item.quantity - 1);
      });
      row.querySelector('[data-increase]')?.addEventListener('click', () => {
        updateQuantity(item.productId, item.quantity + 1);
      });
      row.querySelector('[data-remove]')?.addEventListener('click', () => {
        removeFromCart(item.productId);
      });
      itemsEl.appendChild(row);
    }

    totalEl.textContent = formatZar(cartTotal(items));
  }

  window.addEventListener('cart:updated', render);
  render();
</script>
