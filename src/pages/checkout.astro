---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Checkout">
  <div class="checkout-page">
    <h1>Checkout</h1>

    <form class="checkout-form" data-checkout-form>
      <h2>Billing details</h2>
      <div class="field-row">
        <label class="field">
          <span>First name *</span>
          <input type="text" name="firstName" required maxlength="60" />
        </label>
        <label class="field">
          <span>Last name *</span>
          <input type="text" name="lastName" required maxlength="60" />
        </label>
      </div>
      <label class="field">
        <span>Email address *</span>
        <input type="email" name="email" required maxlength="120" />
      </label>
      <label class="field">
        <span>Phone *</span>
        <input type="tel" name="phone" required maxlength="30" />
      </label>
      <label class="field">
        <span>Street address *</span>
        <input type="text" name="address1" required maxlength="200" />
      </label>
      <div class="field-row">
        <label class="field">
          <span>Town / City *</span>
          <input type="text" name="city" required maxlength="100" />
        </label>
        <label class="field">
          <span>Postcode *</span>
          <input type="text" name="postcode" required maxlength="20" />
        </label>
      </div>

      <h2>Your order</h2>
      <table class="order-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Subtotal</th>
          </tr>
        </thead>
        <tbody data-order-items></tbody>
        <tfoot>
          <tr>
            <th scope="row">Subtotal</th>
            <td data-order-subtotal></td>
          </tr>
          <tr>
            <th scope="row">Delivery</th>
            <td data-order-shipping>calculating…</td>
          </tr>
          <tr class="order-total-row">
            <th scope="row">Total</th>
            <td data-order-total></td>
          </tr>
        </tfoot>
      </table>

      <h2>Payment method</h2>
      <div class="payment-method">
        <p><strong>Direct bank transfer</strong></p>
        <p class="payment-note">
          Make your payment directly into our bank account. Please use your order number as the payment reference.
          Your order will not be shipped until the funds have cleared in our account. You'll receive the account
          details by email once your order is placed.
        </p>
      </div>

      <button type="submit" class="pay-btn">Place order</button>
      <p class="checkout-error" data-checkout-error hidden></p>
    </form>
  </div>
</Layout>

<style>
  .checkout-page {
    padding: 16px 16px calc(16px + var(--nav-height));
    overflow-y: auto;
    height: 100%;
    max-width: 480px;
    margin: 0 auto;
  }
  h1 {
    font-size: 20px;
  }
  h2 {
    font-size: 15px;
    font-weight: 700;
    margin: 24px 0 10px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
  }
  .checkout-form {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .field-row {
    display: flex;
    gap: 10px;
  }
  .field {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 12px;
    color: var(--muted);
    min-width: 0;
  }
  .checkout-form input {
    background: var(--input-bg);
    border: 1px solid var(--input-border);
    border-radius: 4px;
    padding: 10px;
    color: var(--fg);
    font-size: 14px;
    min-width: 0;
  }
  .order-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
  }
  .order-table th,
  .order-table td {
    border: 1px solid var(--border);
    padding: 10px 12px;
    text-align: left;
  }
  .order-table thead th {
    background: var(--card-bg);
    font-weight: 700;
  }
  .order-table tfoot th {
    font-weight: 600;
    color: var(--muted);
  }
  .order-table td {
    text-align: right;
  }
  .order-total-row th,
  .order-total-row td {
    font-weight: 700;
    color: var(--fg);
  }
  .payment-method {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 12px 14px;
  }
  .payment-method p {
    margin: 0 0 8px;
    font-size: 13px;
  }
  .payment-note {
    color: var(--muted);
    margin: 0 !important;
  }
  .pay-btn {
    background: var(--primary);
    color: var(--primary-text);
    border: none;
    border-radius: 8px;
    padding: 14px;
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    margin-top: 8px;
  }
  .pay-btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }
  .checkout-error {
    color: #d92d20;
    font-size: 13px;
  }
</style>

<script>
  import { getCart, cartTotal, clearCart } from '../lib/cart';
  import { startCheckout, fetchShippingCost, type CartItem } from '../lib/api';
  import { withBase } from '../lib/base';

  const ORDER_STORAGE_KEY = 'tiktok-shop-last-order';

  const itemsBody = document.querySelector<HTMLElement>('[data-order-items]')!;
  const subtotalEl = document.querySelector<HTMLElement>('[data-order-subtotal]')!;
  const shippingEl = document.querySelector<HTMLElement>('[data-order-shipping]')!;
  const totalEl = document.querySelector<HTMLElement>('[data-order-total]')!;
  const form = document.querySelector<HTMLFormElement>('[data-checkout-form]')!;
  const errorEl = document.querySelector<HTMLElement>('[data-checkout-error]')!;

  function formatZar(amount: number): string {
    return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(amount);
  }

  function renderItems(cart: CartItem[]) {
    itemsBody.innerHTML = cart
      .map(
        (item) => `
      <tr>
        <td>${item.name} × ${item.quantity}</td>
        <td>${formatZar(item.unitPrice * item.quantity)}</td>
      </tr>
    `
      )
      .join('');
  }

  const cart = getCart();
  if (cart.length === 0) {
    window.location.href = withBase('/cart');
  } else {
    const itemsTotal = cartTotal(cart);
    renderItems(cart);
    subtotalEl.textContent = formatZar(itemsTotal);
    totalEl.textContent = formatZar(itemsTotal);
    fetchShippingCost().then((shipping) => {
      shippingEl.textContent = shipping.cost > 0 ? formatZar(shipping.cost) : 'Free';
      totalEl.textContent = formatZar(itemsTotal + shipping.cost);
    });
  }

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const submitBtn = form.querySelector<HTMLButtonElement>('.pay-btn')!;
    submitBtn.disabled = true;
    errorEl.hidden = true;

    const formData = new FormData(form);
    try {
      const result = await startCheckout(getCart(), {
        firstName: String(formData.get('firstName') ?? ''),
        lastName: String(formData.get('lastName') ?? ''),
        email: String(formData.get('email') ?? ''),
        phone: String(formData.get('phone') ?? ''),
        address1: String(formData.get('address1') ?? ''),
        city: String(formData.get('city') ?? ''),
        postcode: String(formData.get('postcode') ?? ''),
      });
      sessionStorage.setItem(ORDER_STORAGE_KEY, JSON.stringify(result));
      clearCart();
      window.location.href = withBase('/checkout/success');
    } catch (err) {
      errorEl.hidden = false;
      errorEl.textContent = err instanceof Error ? err.message : 'Checkout failed, please try again.';
      submitBtn.disabled = false;
    }
  });
</script>
