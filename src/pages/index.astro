---
import Layout from '../layouts/Layout.astro';
import VideoFeed from '../components/VideoFeed.astro';
import { mockProducts, type Product } from '../data/mockProducts';
import { listProducts } from '../lib/woocommerce';
import { mapWooProducts } from '../lib/mapProduct';

export const prerender = false;

let products: Product[] = mockProducts;
try {
  const env = Astro.locals.runtime.env;
  const params = new URLSearchParams({ per_page: '20', status: 'publish' });
  const wooProducts = await listProducts(env, params);
  if (wooProducts.length > 0) products = mapWooProducts(wooProducts);
} catch (err) {
  // WooCommerce unreachable (e.g. local `astro dev` without bindings) — fall back to mock data.
  console.error('WooCommerce fetch failed on /:', err);
}
---

<Layout title="Shop the feed">
  <VideoFeed products={products} />
</Layout>
