---
import Layout from '../../layouts/Layout.astro';
import { getProductBySlug as getMockProductBySlug, type Product } from '../../data/mockProducts';
import { withBase } from '../../lib/base';
import { getProductBySlug } from '../../lib/woocommerce';
import { mapWooProduct } from '../../lib/mapProduct';

export const prerender = false;

const slug = Astro.params.slug as string;
let product: Product | undefined;

try {
  const env = Astro.locals.runtime.env;
  const wooProduct = await getProductBySlug(env, slug);
  if (wooProduct) product = mapWooProduct(wooProduct);
} catch (err) {
  // WooCommerce unreachable (e.g. local `astro dev` without bindings) — fall back to mock data.
  console.error('WooCommerce fetch failed on /product/[slug]:', err);
}
if (!product) product = getMockProductBySlug(slug);
if (!product) return Astro.redirect(withBase('/shop'));

const priceFormatted = new Intl.NumberFormat('en-ZA', { style: 'currency', currency: product.currency }).format(product.price);
---

<Layout title={product.title}>
  <div class="product-page">
    <a class="back-link" href={withBase('/')}>← Back</a>
    <video class="product-video" src={product.videoUrl} poster={product.posterUrl} controls playsinline></video>

    <div class="product-details">
      <h1>{product.title}</h1>
      <p class="price">{priceFormatted}</p>

      {
        product.requiresUpload && (
          <div class="upload-section" data-upload-section>
            <label class="upload-label" for="design-file">Upload your design</label>
            <p class="upload-hint">Add the photo or artwork you'd like printed on this item (JPG, PNG, WEBP — max 8MB).</p>
            <input type="file" id="design-file" accept="image/jpeg,image/png,image/webp,image/gif" data-design-input />
            <div class="upload-preview" data-upload-preview hidden>
              <img data-upload-preview-img alt="Your uploaded design" />
              <span class="upload-status" data-upload-status></span>
            </div>
            <p class="upload-error" data-upload-error hidden></p>
          </div>
        )
      }

      <div class="qty-row">
        <label for="qty">Qty</label>
        <input type="number" id="qty" value="1" min="1" max="10" />
      </div>

      <button
        class="buy-now-btn"
        data-buy-now
        data-product-id={product.id}
        data-price={product.price}
        data-name={product.title}
        data-image={product.posterUrl}
        data-requires-upload={product.requiresUpload ? 'true' : 'false'}
      >
        Buy Now
      </button>
      <button
        class="add-cart-btn"
        data-add-cart
        data-product-id={product.id}
        data-price={product.price}
        data-name={product.title}
        data-image={product.posterUrl}
        data-requires-upload={product.requiresUpload ? 'true' : 'false'}
      >
        Add to Cart
      </button>

      {
        product.description && (
          <div class="description-section">
            <h2>Description</h2>
            <div class="description-body" set:html={product.description} />
          </div>
        )
      }
    </div>
  </div>
</Layout>

<style>
  .product-page {
    padding: 16px 16px calc(16px + var(--nav-height));
    overflow-y: auto;
    height: 100%;
  }
  .back-link {
    color: var(--muted);
    text-decoration: none;
    font-size: 13px;
  }
  .product-video {
    width: 100%;
    max-height: 50vh;
    border-radius: 12px;
    margin: 12px 0;
    background: #000;
  }
  h1 {
    font-size: 26px;
    font-weight: 700;
    margin: 0 0 8px;
  }
  .price {
    font-size: 24px;
    font-weight: 800;
    color: var(--secondary-text);
    margin: 0 0 16px;
  }
  .upload-section {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 16px;
  }
  .upload-label {
    display: block;
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 4px;
  }
  .upload-hint {
    color: var(--muted);
    font-size: 12px;
    margin: 0 0 10px;
  }
  .upload-section input[type='file'] {
    color: var(--fg);
    font-size: 13px;
    width: 100%;
  }
  .upload-preview {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-top: 10px;
  }
  .upload-preview img {
    width: 56px;
    height: 56px;
    object-fit: cover;
    border-radius: 8px;
  }
  .upload-status {
    font-size: 13px;
    color: var(--muted);
  }
  .upload-error {
    color: #ff6b6b;
    font-size: 13px;
    margin: 8px 0 0;
  }
  .qty-row {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
  }
  .qty-row input {
    width: 60px;
    padding: 6px;
    border-radius: 6px;
    border: 1px solid var(--input-border);
    background: var(--input-bg);
    color: var(--fg);
  }
  .buy-now-btn,
  .add-cart-btn {
    display: block;
    width: 100%;
    border: none;
    cursor: pointer;
  }
  .buy-now-btn {
    padding: 18px;
    border-radius: 10px;
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.01em;
    background: var(--secondary);
    color: var(--secondary-text);
    box-shadow: 0 4px 14px rgba(235, 220, 58, 0.45);
    margin-bottom: 12px;
  }
  .add-cart-btn {
    padding: 13px;
    border-radius: 8px;
    font-weight: 600;
    font-size: 14px;
    background: var(--card-bg);
    border: 1px solid var(--border);
    color: var(--fg);
    margin-bottom: 10px;
  }
  .description-section {
    margin-top: 24px;
    padding-top: 16px;
    border-top: 1px solid var(--border);
  }
  .description-section h2 {
    font-size: 15px;
    margin: 0 0 8px;
  }
  .description-body {
    font-size: 14px;
    color: var(--fg);
    line-height: 1.6;
  }
  .description-body :global(p) {
    margin: 0 0 10px;
  }
  .description-body :global(ul),
  .description-body :global(ol) {
    margin: 0 0 10px;
    padding-left: 20px;
  }
  .description-body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }
</style>

<script>
  import { addToCart } from '../../lib/cart';
  import { uploadDesign } from '../../lib/api';
  import { withBase } from '../../lib/base';

  let uploadedDesignUrl: string | null = null;
  let uploading = false;

  const designInput = document.querySelector<HTMLInputElement>('[data-design-input]');
  const previewEl = document.querySelector<HTMLElement>('[data-upload-preview]');
  const previewImg = document.querySelector<HTMLImageElement>('[data-upload-preview-img]');
  const statusEl = document.querySelector<HTMLElement>('[data-upload-status]');
  const uploadErrorEl = document.querySelector<HTMLElement>('[data-upload-error]');

  designInput?.addEventListener('change', async () => {
    const file = designInput.files?.[0];
    if (!file || !statusEl || !previewEl || !previewImg) return;

    uploadedDesignUrl = null;
    uploading = true;
    if (uploadErrorEl) uploadErrorEl.hidden = true;
    previewEl.hidden = false;
    previewImg.src = URL.createObjectURL(file);
    statusEl.textContent = 'Uploading...';

    try {
      const { url } = await uploadDesign(file);
      uploadedDesignUrl = url;
      statusEl.textContent = 'Uploaded ✓';
    } catch (err) {
      statusEl.textContent = '';
      if (uploadErrorEl) {
        uploadErrorEl.hidden = false;
        uploadErrorEl.textContent = err instanceof Error ? err.message : 'Upload failed, please try again.';
      }
    } finally {
      uploading = false;
    }
  });

  function readButtonProduct(btn: HTMLElement) {
    return {
      productId: Number(btn.dataset.productId),
      slug: window.location.pathname.split('/').pop() ?? '',
      name: btn.dataset.name ?? '',
      unitPrice: Number(btn.dataset.price),
      imageUrl: btn.dataset.image ?? '',
      designImageUrl: uploadedDesignUrl ?? undefined,
    };
  }

  function currentQty(): number {
    const input = document.getElementById('qty') as HTMLInputElement | null;
    return Math.max(1, Number(input?.value ?? 1));
  }

  /** Blocks add-to-cart/buy-now until a required design upload is finished. */
  function uploadIsMissing(btn: HTMLElement): boolean {
    if (btn.dataset.requiresUpload !== 'true') return false;
    if (uploading) {
      if (uploadErrorEl) {
        uploadErrorEl.hidden = false;
        uploadErrorEl.textContent = 'Please wait for your design to finish uploading.';
      }
      return true;
    }
    if (!uploadedDesignUrl) {
      if (uploadErrorEl) {
        uploadErrorEl.hidden = false;
        uploadErrorEl.textContent = 'Please upload your design before adding this item.';
      }
      return true;
    }
    return false;
  }

  document.querySelector('[data-add-cart]')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement;
    if (uploadIsMissing(btn)) return;
    addToCart({ ...readButtonProduct(btn), quantity: currentQty() });
    btn.textContent = 'Added ✓';
    setTimeout(() => (btn.textContent = 'Add to Cart'), 1200);
  });

  document.querySelector('[data-buy-now]')?.addEventListener('click', (e) => {
    const btn = e.currentTarget as HTMLElement;
    if (uploadIsMissing(btn)) return;
    addToCart({ ...readButtonProduct(btn), quantity: currentQty() });
    window.location.href = withBase('/checkout');
  });
</script>
