---
import Layout from '../layouts/Layout.astro';

// Login, registration, order history, and account details are all handled
// by WooCommerce's own native "My Account" page — no reason to rebuild any
// of that here. This page only adds what WooCommerce doesn't have out of
// the box: the wishlist (device-local, not tied to an account).
const MY_ACCOUNT_URL = 'https://ecommercegoods.co.za/my-account/';
---

<Layout title="My Account">
  <div class="account-page">
    <h1>My Account</h1>

    <a class="my-account-card" href={MY_ACCOUNT_URL}>
      <div class="my-account-card-text">
        <p class="my-account-card-title">Sign in or create an account</p>
        <p class="my-account-card-hint">View your orders, manage your details, and sign in — on our secure account page.</p>
      </div>
      <span class="my-account-card-arrow" aria-hidden="true">→</span>
    </a>

    <h2>Wishlist</h2>
    <div data-wishlist-list class="wishlist-grid"></div>
    <p class="hint" data-wishlist-empty hidden>Your wishlist is empty — heart a product in the feed to save it here.</p>
  </div>
</Layout>

<style>
  .account-page {
    padding: 16px 16px calc(16px + var(--nav-height));
    overflow-y: auto;
    height: 100%;
  }
  h1 {
    font-size: 20px;
    margin: 0;
  }
  h2 {
    font-size: 15px;
    margin: 24px 0 10px;
  }
  .hint {
    color: var(--muted);
    font-size: 13px;
  }

  .my-account-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: var(--primary);
    color: var(--primary-text);
    text-decoration: none;
    border-radius: 10px;
    padding: 16px;
    margin-top: 14px;
  }
  .my-account-card-title {
    margin: 0 0 4px;
    font-weight: 700;
    font-size: 15px;
  }
  .my-account-card-hint {
    margin: 0;
    font-size: 12px;
    opacity: 0.85;
  }
  .my-account-card-arrow {
    font-size: 20px;
    flex-shrink: 0;
  }

  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px;
  }
  .wishlist-card {
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: var(--fg);
    position: relative;
  }
  .wishlist-card img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    display: block;
  }
  .wishlist-card-info {
    padding: 8px;
  }
  .wishlist-card-title {
    font-size: 13px;
    margin: 0 0 4px;
  }
  .wishlist-card-price {
    font-size: 13px;
    font-weight: 700;
    margin: 0;
    color: var(--secondary-text);
  }
  .wishlist-remove {
    position: absolute;
    top: 6px;
    right: 6px;
    background: rgba(0, 0, 0, 0.6);
    color: #fff;
    border: none;
    border-radius: 50%;
    width: 24px;
    height: 24px;
    font-size: 13px;
    cursor: pointer;
    line-height: 1;
  }
</style>

<script>
  import { fetchProductsByIds } from '../lib/api';
  import { withBase } from '../lib/base';

  function formatZar(amount: number): string {
    return new Intl.NumberFormat('en-ZA', { style: 'currency', currency: 'ZAR' }).format(amount);
  }

  const WISHLIST_KEY = 'tiktok-shop-wishlist';

  function getWishlist(): string[] {
    try {
      return JSON.parse(localStorage.getItem(WISHLIST_KEY) ?? '[]');
    } catch {
      return [];
    }
  }

  function setWishlist(ids: string[]) {
    localStorage.setItem(WISHLIST_KEY, JSON.stringify(ids));
  }

  interface WooProductLite {
    id: number;
    slug: string;
    name: string;
    price: string;
    images: { src: string }[];
  }

  const wishlistList = document.querySelector<HTMLElement>('[data-wishlist-list]');
  const wishlistEmpty = document.querySelector<HTMLElement>('[data-wishlist-empty]');

  async function renderWishlist() {
    const ids = getWishlist();
    if (!wishlistList) return;
    if (ids.length === 0) {
      wishlistList.innerHTML = '';
      if (wishlistEmpty) wishlistEmpty.hidden = false;
      return;
    }
    if (wishlistEmpty) wishlistEmpty.hidden = true;
    wishlistList.innerHTML = '<p class="hint">Loading your wishlist…</p>';

    try {
      const products: WooProductLite[] = await fetchProductsByIds(ids);
      const byId = new Map(products.map((p) => [String(p.id), p]));
      const ordered = ids.map((id) => byId.get(id)).filter((p): p is WooProductLite => !!p);

      if (ordered.length === 0) {
        wishlistList.innerHTML = '';
        if (wishlistEmpty) wishlistEmpty.hidden = false;
        return;
      }

      wishlistList.innerHTML = '';
      for (const product of ordered) {
        const card = document.createElement('a');
        card.className = 'wishlist-card';
        card.href = withBase(`/product/${product.slug}`);
        card.innerHTML = `
          <img src="${product.images?.[0]?.src ?? ''}" alt="${product.name}" loading="lazy" />
          <div class="wishlist-card-info">
            <p class="wishlist-card-title">${product.name}</p>
            <p class="wishlist-card-price">${formatZar(Number(product.price || 0))}</p>
          </div>
          <button class="wishlist-remove" type="button" data-remove-id="${product.id}" aria-label="Remove from wishlist">✕</button>
        `;
        card.querySelector('[data-remove-id]')?.addEventListener('click', (e) => {
          e.preventDefault();
          e.stopPropagation();
          setWishlist(getWishlist().filter((id) => id !== String(product.id)));
          renderWishlist();
        });
        wishlistList.appendChild(card);
      }
    } catch {
      wishlistList.innerHTML = '<p class="hint">Unable to load your wishlist right now.</p>';
    }
  }

  renderWishlist();
</script>
