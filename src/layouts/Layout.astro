---
import BottomNav from '../components/BottomNav.astro';
import { withBase } from '../lib/base';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** The immersive video feed hides the header to stay full-bleed; every other page shows it. */
  showHeader?: boolean;
}

const { title, description = 'TikTok-style video shopping, made in Cape Town.', showHeader = true } = Astro.props;
const turnstileSiteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#00406d" />
    {turnstileSiteKey && <script is:inline defer src="https://challenges.cloudflare.com/turnstile/v0/api.js"></script>}
  </head>
  <body>
    <div class="app-shell">
      {
        showHeader && (
          <header class="site-header">
            <span class="site-logo-name">ecommercegoods.co.za</span>
            <span class="site-logo-tag">Personalised Gifts</span>
          </header>
        )
      }
      <main class="app-main">
        <slot />
      </main>
      <a href={withBase('/cart')} class="cart-pill" data-cart-pill aria-label="View cart">
        <span class="cart-icon" aria-hidden="true">🛒</span>
        <span class="cart-count" data-cart-count hidden>0</span>
      </a>
      <BottomNav />
    </div>

    <script>
      import { getCart, cartCount } from '../lib/cart';

      function updateCartPill() {
        const countEl = document.querySelector<HTMLElement>('[data-cart-count]');
        if (!countEl) return;
        const count = cartCount(getCart());
        countEl.textContent = String(count);
        countEl.hidden = count === 0;
      }
      window.addEventListener('cart:updated', updateCartPill);
      updateCartPill();
    </script>
  </body>
</html>

<style>
  .site-header {
    display: flex;
    align-items: baseline;
    gap: 8px;
    padding: calc(14px + env(safe-area-inset-top, 0px)) 16px 14px;
    background: var(--primary);
    color: var(--primary-text);
    flex-shrink: 0;
  }
  .site-logo-name {
    font-weight: 800;
    font-size: 16px;
    letter-spacing: -0.02em;
  }
  .site-logo-tag {
    font-size: 12px;
    color: var(--secondary);
    font-weight: 600;
  }
  .cart-pill {
    position: fixed;
    top: calc(14px + env(safe-area-inset-top, 0px));
    right: 14px;
    z-index: 30;
    background: #fff;
    text-decoration: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.3);
  }
  .cart-icon {
    font-size: 22px;
    line-height: 1;
  }
  .cart-count {
    position: absolute;
    top: -4px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 4px;
    border-radius: 10px;
    background: var(--secondary);
    color: var(--secondary-text);
    font-size: 12px;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.3);
  }
</style>
