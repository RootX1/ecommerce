---
// Single shared bottom-sheet instance, reused for whichever product is
// currently active in the feed. Content is populated client-side by
// VideoFeed.astro's script so this stays one DOM node instead of one per video.
// Reviews are READ here (via the WooCommerce REST API) but WRITTEN on the
// actual WooCommerce product page — that page already has a fully working
// review form gated by native WordPress login, verified-purchase badges,
// and moderation, so there's no reason to rebuild any of that here.
---

<div class="review-sheet-backdrop" data-review-backdrop hidden>
  <div class="review-sheet" data-review-sheet role="dialog" aria-modal="true" aria-labelledby="review-sheet-title">
    <div class="sheet-handle" data-review-close></div>
    <header class="sheet-header">
      <h2 id="review-sheet-title">Reviews</h2>
      <button class="close-btn" data-review-close aria-label="Close reviews">✕</button>
    </header>

    <div class="rating-summary" data-review-summary></div>

    <div class="review-list" data-review-list>
      <p class="empty-state" data-review-empty hidden>No reviews yet — be the first!</p>
    </div>

    <a class="write-review-btn" data-write-review-link href="#" target="_blank" rel="noopener noreferrer">
      Write a review on our site
    </a>
  </div>
</div>

<style>
  .review-sheet-backdrop {
    position: fixed;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    z-index: 50;
    display: flex;
    align-items: flex-end;
  }

  .review-sheet-backdrop[hidden] {
    display: none;
  }

  .review-sheet {
    background: var(--sheet-bg);
    color: var(--fg);
    width: 100%;
    max-height: 80vh;
    border-radius: 16px 16px 0 0;
    display: flex;
    flex-direction: column;
    padding: 8px 16px calc(16px + var(--safe-bottom));
    transform: translateY(0);
    transition: transform 0.25s ease;
    box-shadow: 0 -4px 24px rgba(0, 0, 0, 0.15);
  }

  .sheet-handle {
    width: 36px;
    height: 4px;
    background: var(--border);
    border-radius: 2px;
    margin: 4px auto 8px;
    cursor: pointer;
  }

  .sheet-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 8px;
  }

  .sheet-header h2 {
    font-size: 16px;
    margin: 0;
  }

  .close-btn {
    background: none;
    border: none;
    color: var(--fg);
    font-size: 16px;
    cursor: pointer;
  }

  .rating-summary {
    font-size: 13px;
    color: var(--muted);
    margin-bottom: 8px;
  }

  .review-list {
    overflow-y: auto;
    flex: 1;
    min-height: 60px;
    margin-bottom: 12px;
  }

  .review-item {
    padding: 10px 0;
    border-bottom: 1px solid var(--border);
  }

  .review-item .review-author {
    font-weight: 600;
    font-size: 13px;
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .verified-badge {
    font-size: 10px;
    background: #12b76a;
    color: #fff;
    padding: 1px 6px;
    border-radius: 8px;
  }

  .review-item .review-stars {
    color: var(--secondary);
    font-size: 12px;
  }

  .review-item .review-text {
    font-size: 13px;
    color: var(--fg);
    margin-top: 4px;
  }

  .empty-state {
    color: var(--muted);
    font-size: 13px;
    text-align: center;
    padding: 20px 0;
  }

  .write-review-btn {
    display: block;
    text-align: center;
    background: var(--primary);
    color: var(--primary-text);
    text-decoration: none;
    border-radius: 8px;
    padding: 13px;
    font-weight: 600;
    font-size: 14px;
    border-top: 1px solid var(--border);
    margin-top: 4px;
  }
</style>
